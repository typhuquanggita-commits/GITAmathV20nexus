# ═══════════════════════════════════════════════════════════════════════════
#  GITAmath Nexus V20 — biến môi trường
#  KHÔNG có biến nào bắt buộc. Để trống hết thì hệ thống vẫn chạy đầy đủ
#  ở chế độ ngoại tuyến (store in-memory, mô hình trả lời theo giao thức).
#  Sao chép tệp này thành .env rồi điền những gì bạn thực sự dùng.
# ═══════════════════════════════════════════════════════════════════════════

# ── Máy chủ ────────────────────────────────────────────────────────────────
PORT=9999
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ── Hạ tầng (để trống = dùng bộ nhớ trong tiến trình) ──────────────────────
# Có Redis thì trạng thái bandit, cache, hàng đợi sống sót qua restart.
REDIS_URL=

# ── Khoá mô hình (có ít nhất một khoá là chạy mô hình thật) ────────────────
# Không có khoá nào → chế độ ngoại tuyến, mọi giao thức vẫn chạy và test được.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_ALLOW_MOCK=true
# Ngắt mạch khi nhà cung cấp lỗi liên tục, rồi thử lại sau khoảng nghỉ.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=60000

# ── Lực lượng 500 agent ────────────────────────────────────────────────────
AGENT_TOTAL=500
AGENT_GLOBAL_CONCURRENCY=64
AGENT_TOKENS_PER_MIN=600000

# ── Ngưỡng KPI (điều A16 hiến pháp) ────────────────────────────────────────
KPI_SUCCESS_RATE=0.9
KPI_QUALITY_SCORE=0.85
KPI_P95_LATENCY_MS=5000
KPI_COST_PER_TASK_USD=0.001
KPI_UTILIZATION=0.6
KPI_COACH_THRESHOLD=0.9

# ── Định tuyến thích ứng ───────────────────────────────────────────────────
# ROUTER_SEED quyết định chuỗi thăm dò của bandit. Cùng seed = cùng kết quả,
# nên mọi phiên chạy đều dựng lại và kiểm định lại được.
ROUTER_SEED=gita-nexus-v20-router
ROUTER_EPSILON=0.15
# Sau bao nhiêu lượt thì giảm dần tỉ lệ thăm dò.
ROUTER_DECAY_AT=1000
ROUTER_W_QUALITY=0.6
ROUTER_W_COST=0.3
ROUTER_W_LATENCY=0.1

# ── Hàng đợi & quản trị ────────────────────────────────────────────────────
QUEUE_CONCURRENCY=16
QUEUE_MAX_ATTEMPTS=3
# Hàng đợi sâu quá mức này thì cảnh báo.
QUEUE_BACKLOG_ALERT=500
# Kết quả một lần chạy giữ lại bao lâu (giây).
RUN_TTL_SEC=86400
RATE_LIMIT_PER_MIN=200
AUDIT_RETENTION_DAYS=365

# ── Bảo lưu theo phiên bản / thời điểm ─────────────────────────────────────
SNAPSHOT_DIR=
SNAPSHOT_INTERVAL_MS=900000

# ── Bảo mật ────────────────────────────────────────────────────────────────
# Chuỗi bí mật trộn thêm vào băm mật khẩu Super Admin. Đặt một chuỗi dài, ngẫu
# nhiên, GIỮ NGOÀI mã nguồn. Đổi giá trị này là mọi mật khẩu cũ hết hiệu lực.
SA_PEPPER=

# ── Hiển thị ───────────────────────────────────────────────────────────────
# Đặt 1 để tắt màu trong nhật ký (khi ghi ra tệp hoặc chạy trong CI).
NO_COLOR=

# ── Dữ liệu nghiệp vụ bền vững ─────────────────────────────────────────────
# Nơi lưu người dùng, học viên, lớp, kho học liệu. Để trống = data/db.
DB_DIR=
# Bật fsync sau mỗi lần ghi: an toàn tuyệt đối khi mất điện, đổi lại chậm hơn.
DB_FSYNC=false

# ── Gieo kho học liệu lần đầu ──────────────────────────────────────────────
# Đặt 0 nếu muốn tự biên soạn từ đầu thay vì để hệ thống gieo sẵn.
SEED_BANK=1
# Số bài gieo cho mỗi ô (dạng × tầng) có bản thiết kế.
SEED_PER_SLOT=3

# ── Giọng nói giảng viên ─────────────────────────────────────────────────────
# Bộ tổng hợp mặc định chạy ngay trong tiến trình: không cần mạng, không cần
# khoá, không giới hạn ký tự. Chỉ đổi khi đã cài piper hoặc có hợp đồng đám mây.
VOICE_PROVIDER=offline
VOICE_SAMPLE_RATE=22050
VOICE_CACHE_MAX=256
VOICE_MAX_CHARS=4000

# edge-tts — giọng nơ-ron tiếng Việt của Microsoft, miễn phí, KHÔNG cần khoá.
# Cài một dòng: pip3 install edge-tts. Cần mạng lúc đọc, xuất ra MP3 nên dùng
# cho tệp tiếng rời; khung video và dấu chìm vẫn do bộ nội bộ lo.
EDGE_TTS_BIN=edge-tts
EDGE_VOICE_FEMALE=vi-VN-HoaiMyNeural
EDGE_VOICE_MALE=vi-VN-NamMinhNeural

# piper — mô hình nơ-ron chạy cục bộ, miễn phí. Để trống là không dùng.
PIPER_BIN=
PIPER_MODEL=

# Dịch vụ đám mây (tuỳ chọn). Để trống thì API báo "chưa sẵn sàng" chứ không hỏng.
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
GOOGLE_TTS_API_KEY=

# Cổng translate_tts của Google Dịch là endpoint KHÔNG CHÍNH THỨC: không hợp
# đồng, chặn theo IP, tối đa ~200 ký tự, vi phạm điều khoản. Chỉ bật để thử.
VOICE_ALLOW_UNOFFICIAL=0

# Pháp lý — Luật An ninh mạng 116/2025/QH15
VOICE_WATERMARK=1
VOICE_RETENTION_DAYS=180
VOICE_MINOR_AGE=18

# ── Bộ tổng hợp nơ-ron tiếng Việt (tuỳ chọn) ────────────────────────────────
# Mỗi bộ nhận MỘT trong hai cách gọi: máy chủ HTTP cục bộ (…_URL) hoặc chạy
# thẳng bằng Python (…_DIR). Để trống cả hai thì bộ đó báo "chưa cài" và hệ
# thống dùng bộ formant nội bộ.
# ZeroTTS   — WER 1,03%, chạy thời gian thực trên CPU, hợp giảng bài trực tiếp
ZEROTTS_URL=
ZEROTTS_DIR=
# VieNeu-TTS v3 — 48kHz, có dấu cảm xúc, hợp bài dài và podcast
VIENEU_URL=
VIENEU_DIR=
# G-OmniVoice — WER 2,59%, hợp nội dung cần đọc thật chuẩn
GOMNIVOICE_URL=
GOMNIVOICE_DIR=
PYTHON_BIN=python3

# ── Hát: tổng hợp và chuyển đổi giọng hát (tuỳ chọn) ───────────────────────
# SoulX-Singer: chất lượng phòng thu nhưng CHƯA có tiếng Việt (Trung/Anh/Quảng)
SOULX_SINGER_DIR=
# OpenUtau + DiffSinger: có voicebank tiếng Việt, đầu vào là tệp .ustx
OPENUTAU_BIN=
OPENUTAU_VOICEBANK=
# So-VITS-SVC: đổi chất giọng của một bản hát thật.
# BẮT BUỘC có phiếu đồng ý của cả người hát gốc lẫn chủ giọng đích.
SOVITS_SVC_DIR=
SOVITS_SVC_MODEL=

# ── Hậu kỳ phòng thu ────────────────────────────────────────────────────────
# Chuỗi xử lý chạy bằng JavaScript trong tiến trình, không cần ffmpeg.
VOICE_STUDIO=1
VOICE_STUDIO_PRESET=giang-bai
# Chỉ dùng khi muốn chuyển mã sang mp3/m4a — không bắt buộc.
FFMPEG_BIN=
# Trần thời lượng một bài hát (giây)
VOICE_MAX_SONG_SECONDS=300

# ── Sản xuất phim (GITAfilm) ────────────────────────────────────────────────
# Không có khoá vẫn dùng được: hệ thống dựng bảng phân cảnh, đường tiếng thật
# và phim nháp xem được trên trình duyệt. Chỉ bước dựng video mới cần khoá.
# Lấy khoá tại https://fal.ai
FAL_KEY=
# Tên cũ theo tài liệu GITAfilm — vẫn đọc được để không phải sửa .env cũ.
KHOA_FAL=
# Thư mục lưu dự án phim. Để trống = cùng chỗ với dữ liệu khác.
FILM_DIR=
# Trần chi tiêu cho MỘT phim (USD). Vượt là chặn, không hỏi lại.
FILM_MAX_USD=25
# Bắt buộc xác nhận tay trước khi gọi API tính tiền. Chỉ tắt khi chạy tự động.
FILM_REQUIRE_CONFIRM=1
# chat-luong | can-bang | tiet-kiem
FILM_PRIORITY=can-bang
# hd | 4k
FILM_QUALITY=hd
# Trần thời lượng một phim (giây)
FILM_MAX_SECONDS=600

# ── Xưởng ảnh (GITA Photo Studio) ───────────────────────────────────────────
# Không cần điền gì vẫn dùng được: khung dựng bố cục và toàn bộ 8 tầng hậu kỳ
# chạy ngay trong tiến trình — đọc PNG/JPEG, phóng to Lanczos, chất màu, đường
# tông phim, làm sắc, hạt, tối góc, soát và xuất. Không cần ffmpeg.
# Chỉ khâu SINH ảnh mới cần dịch vụ ngoài.
# mien-phi | tai-may | hon-hop | co-khoa
PHOTO_MODE=mien-phi
# Cổng miễn phí không cần khoá. Đổi được để trỏ về máy chủ nội bộ.
POLLINATIONS_URL=https://image.pollinations.ai
# ComfyUI chạy tại máy: 0 đồng, dữ liệu không ra khỏi máy, cần GPU
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_MODEL=flux1-schnell.safetensors
# Hugging Face (tuỳ chọn): huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=black-forest-labs/FLUX.1-schnell
# hd | 2k | 4k | 8k
PHOTO_QUALITY=4k
# Fujifilm | Canon | Sony | Leica | Hasselblad | ARRI | RED | iPhone | KhongApDung
PHOTO_CAMERA=Fujifilm
# Khong | KodakPortra400 | KodakEktar100 | FujiVelvia50 | FujiProvia100F | IlfordHP5 | Cinestill800T
PHOTO_FILM=Khong
# Trần bảo vệ bộ nhớ
PHOTO_MAX_MP=36
PHOTO_MAX_INPUT_BYTES=26214400
PHOTO_JPEG_QUALITY=94

# ── Bài giảng: một lệnh chủ đề → video có tiếng ─────────────────────────────
# Dựng hoàn toàn trong tiến trình: không ffmpeg, không mạng, không khoá.
# LESSON_QUALITY: nhap (854×480) | hd (1280×720) | full-hd (1920×1080)
LESSON_QUALITY=hd
LESSON_JPEG_QUALITY=86
LESSON_OUT_DIR=
LESSON_MAX_MINUTES=30

# ── Trang công khai và SEO ───────────────────────────────────────────────────
# Địa chỉ gốc PHẢI là tên miền thật khi phát hành: thẻ canonical và sơ đồ
# trang trỏ sai tên miền thì công cụ tìm kiếm bỏ qua toàn bộ trang.
WEB_BASE_URL=https://gitamath.vn
WEB_ORG_NAME=GITAmath
WEB_ORG_DESC=
WEB_CONTACT=
# Đặt 0 để tắt hẳn trang công khai, chỉ chạy API và giao diện nội bộ.
WEB_PUBLIC=1

# ── Dòng tiền: trần chi mô hình ─────────────────────────────────────────────
# Sổ cái CHẶN CỨNG khi một khoản chi vượt trần, chứ không chỉ cảnh báo. Đặt
# thấp hơn mức chịu được, vì cái giá của việc chặn nhầm rẻ hơn cái giá của một
# đêm gọi mô hình chạy loạn. Để trống là dùng mặc định trong src/dong-tien.
NGAN_SACH_NGAY_USD=5
NGAN_SACH_THANG_USD=100

# ── CORS: danh sách gốc được gọi API từ trình duyệt ─────────────────────────
# ĐỂ TRỐNG LÀ ĐÓNG HẲN — không gốc ngoài nào gọi được. Chỉ khai khi thật sự có
# một trang khác cần gọi, và khai đích danh từng gốc, cách nhau bằng dấu phẩy.
# CẤM đặt '*': cookie phiên đi kèm yêu cầu, mở sao là mở luôn phiên người dùng.
CORS_ORIGINS=

# ── Vé chống giả mạo biểu mẫu (CSRF) ────────────────────────────────────────
# Khoá ký vé của biểu mẫu khu riêng. ĐỂ TRỐNG LÀ ĐÚNG với cách chạy hiện nay:
# bảng phiên nằm trong bộ nhớ tiến trình, nên khởi động lại là mọi phiên mất —
# vé cũ không còn gì để bảo vệ, và hệ thống tự sinh khoá mới mỗi lần khởi động.
# CHỈ khai khi phiên được lưu xuống đĩa hoặc chạy nhiều tiến trình sau cân tải.
# Khai thì phải từ 32 ký tự trở lên; ngắn hơn bị bỏ qua, vì một khoá ngắn cho
# cảm giác an toàn mà không cho sự an toàn.
CSRF_SECRET=

# ── Ảnh chụp sao lưu định kỳ ────────────────────────────────────────────────
# Đây là ĐƯỜNG LUI DUY NHẤT khi tệp dữ liệu hỏng. Chính sách giữ theo kiểu
# ông–cha–con: 12 ảnh trong giờ gần nhất · 24 ảnh trong 24 giờ · 30 ảnh trong
# 30 ngày; ảnh chụp tay giữ vĩnh viễn.
#
# SNAPSHOT_AUTO=0 TẮT HẲN việc tự chụp — chỉ dành cho môi trường chạy thử.
# Tắt trên máy chạy thật nghĩa là hỏng tệp dữ liệu vào một ngày không ai bấm
# nút thì KHÔNG CÓ GÌ để lui về. Tổ thanh tra TT01 soi việc này mỗi lượt.
SNAPSHOT_AUTO=1

# ─────────────────────────────────────────────────────────────────────────
# BAN QUẢN TRỊ QUAN HỆ GIA ĐÌNH (CRM)
# ─────────────────────────────────────────────────────────────────────────

# Lối định tuyến câu hỏi cho ba mươi trợ lý:
#   tu-khoa   so từ khoá — nhanh, TẤT ĐỊNH, không tốn một đồng nào
#   mo-hinh   hỏi mô hình ngôn ngữ — đọc được câu lạ, nhưng chậm và không tất định
#   ghep      so từ khoá trước, chỉ hỏi mô hình khi từ khoá không chắc  (mặc định)
#
# Mục kiểm chạy ở lối tu-khoa để kết quả lặp lại được.
CRM_LOI_DINH_TUYEN=ghep

# CRM_LICH_VIEC=0 TẮT năm việc chạy nền (bản tin sáng, soi công nợ, quét bất
# thường, đóng việc chờ duyệt quá hạn, chấm bảng điểm). Chỉ dùng cho môi
# trường chạy thử. Tắt trên máy chạy thật nghĩa là việc chờ duyệt không bao
# giờ hết hạn, và kỳ học phí quá hạn không bao giờ được đánh dấu.
CRM_LICH_VIEC=1

# ─────────────────────────────────────────────────────────────────────────
# ĐĂNG NHẬP BẰNG KHUÔN MẶT THẬT (WebAuthn)
# ─────────────────────────────────────────────────────────────────────────
#
# Hệ thống dùng bộ xác thực GẮN TRONG MÁY của người dùng — Windows Hello
# Face, Touch ID, Face ID. Windows Hello Face dùng camera hồng ngoại đo
# chiều sâu, nên ảnh in và video phát lại đều không qua được. Đặc trưng
# khuôn mặt KHÔNG BAO GIỜ rời khỏi máy người dùng; máy chủ chỉ giữ khoá
# công khai.
#
# Hai biến dưới đây PHẢI khớp tên miền thật lúc chạy, nếu không trình duyệt
# từ chối ngay ở phía nó và người dùng thấy lỗi mà không hiểu vì sao.

# Định danh máy chủ. Là TÊN MIỀN, không kèm giao thức và không kèm cổng.
WEBAUTHN_RP_ID=localhost

# Các gốc được phép, cách nhau bằng dấu phẩy. Có giao thức và cổng.
WEBAUTHN_ORIGINS=http://localhost:9999,http://127.0.0.1:9999

# LƯU Ý CỦA CHUẨN, không phải lựa chọn của hệ thống này: ngoài localhost,
# WebAuthn CHỈ chạy trên HTTPS. Chạy tên miền thật qua HTTP thì trình duyệt
# không cho đăng nhập bằng khuôn mặt, và không có cách nào tắt ràng buộc ấy.
#
# Ví dụ khi chạy thật:
#   WEBAUTHN_RP_ID=gitamath.vn
#   WEBAUTHN_ORIGINS=https://gitamath.vn,https://www.gitamath.vn

# ═══════════════════════════════════════════════════════════════════════════
#  SỔ CÔNG CHỨNG CỦA TRỢ LÝ TRÒ CHUYỆN
# ═══════════════════════════════════════════════════════════════════════════
#
# Mỗi lượt trò chuyện được KÝ bằng Ed25519 và móc xích vào lượt trước. Chuỗi
# băm một mình chỉ chứng minh được "không ai sửa giữa chừng"; chữ ký chứng
# minh thêm một điều khác hẳn: dòng này do CHÍNH hệ thống này ghi, chứ không
# phải ai đó dựng lại cả cuốn sổ từ đầu.
#
# KHÔNG KHAI thì hệ TỰ SINH một khoá theo tiến trình. Chạy thử thì tiện,
# nhưng khởi động lại là mọi chữ ký cũ không kiểm được nữa — và một cuốn sổ
# không kiểm lại được thì không phải là sổ.
#
# Sinh khoá:
#   openssl genpkey -algorithm ed25519 -out notary.pem
#   CHU_KY_SO_KHOA_RIENG="$(cat notary.pem)"
#
# Giữ tệp này như giữ mật khẩu quản trị. Lộ khoá riêng thì ai cũng ký được
# một dòng giả và không ai phân biệt được với dòng thật.
# CHU_KY_SO_KHOA_RIENG=

# ═══════════════════════════════════════════════════════════════════════════
#  VIDEO HƯỚNG DẪN
# ═══════════════════════════════════════════════════════════════════════════
#
# Nơi cất tệp video hướng dẫn đã dựng. Không khai thì dùng thư mục con
# "video-huong-dan" trong LESSON_OUT_DIR.
#
# Một video hai phút ở khổ HD nặng chừng 30MB, và bộ đủ là 40 video (10 màn
# hình × 4 vai). Tính chỗ trước khi dựng cả bộ.
# VIDEO_HD_DIR=
